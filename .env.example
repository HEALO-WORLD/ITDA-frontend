# Next.js 로컬 개발 및 서버 실행 시 사용할 Gateway 주소
# Vercel 배포 환경에서는 CloudFront HTTPS 주소로 설정
API_BASE_URL=http://localhost:8080

# Docker 컨테이너 내부에서 접근할 Gateway 주소
# 컨테이너에서는 localhost 대신 Docker 서비스명을 사용
DOCKER_API_BASE_URL=http://gateway-service:8080


# 검사기관 장비 장애 등록 기능 활성화 여부
# true: 등록 기능 활성화 / false: 비활성화
# NEXT_PUBLIC_* 변수는 빌드 시 반영되므로 변경 후 재빌드 필요
NEXT_PUBLIC_ENABLE_EQUIPMENT_DOWNTIME_REGISTRATION=true

# 호스트에서 접근할 프론트엔드 포트
# Grafana가 3000번 포트를 사용하므로 충돌 방지를 위해 3001번 사용
FRONTEND_PORT=3001

# 프론트엔드 컨테이너가 연결할 백엔드 Docker 네트워크
# 백엔드 Docker Compose가 먼저 실행되어 있어야 함
# 실제 네트워크명은 docker network ls 명령어로 확인
ITDA_BACKEND_NETWORK=itda_default